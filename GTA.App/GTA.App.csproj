<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      MEMORY: small, compacting GC (this is an interactive desktop app, not a server).
      - Workstation, NON-concurrent GC: no background-GC thread and no extra BGC heap. The heap is small
        (chat data and widgets are loaded on demand from disk), so a blocking gen2 GC is only a few ms.
      - TieredPGO off: no instrumentation tier, less JIT memory.
      - ConserveMemory: gen2 GC compacts fragmented memory and gives it back to the OS sooner.
      - RetainVM off: freed GC memory goes back to Windows instead of being kept "just in case".
      MemoryGovernor (Src/App/MemoryGovernor.cs) additionally runs a compacting GC after idle / session switch.
    -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"                Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop"        Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent"  Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter"    Version="11.3.11" />
    <PackageReference Include="Avalonia.Diagnostics"    Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Memory debug window (self memory dump + heap analysis). NOT part of the co-worker build:
    the packages are not even referenced there, and the code is compiled out with "#if !CO_WORKER_USE".
  -->
  <ItemGroup Condition="'$(CoWorkerUse)' != 'true'">
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime"        Version="3.1.512801" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GTA.Core\GTA.Core.csproj" />
    <ProjectReference Include="..\GTA.Builder\GTA.Builder.csproj" />
    <ProjectReference Include="..\GTA.Tools\GTA.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\model_pricing.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Co-worker build: the developer's init.ini (real secrets!) is NEVER copied. tools\Pack-CoWorkerConfig.ps1 writes a sanitized one (see target below). -->
    <Content Include="Config\init.ini" Condition="'$(CoWorkerUse)' != 'true' And Exists('Config\init.ini')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config\init.ini.example" Condition="Exists('Config\init.ini.example')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    CO_WORKER_USE post-build / post-publish step: split the developer's init.ini into
      Config\init.ini                         plain text, non-sensitive keys only
      Credentials\my_credentials.dat          AES-256 encrypted JSON (azure_key, azure_anthropic_endpoint, empty user credentials)
    Removed from the co-worker build: gemini_api_key, azure_cognitive_endpoint, github_pat. Details: tools\Pack-CoWorkerConfig.ps1
    A failure here FAILS the build on purpose (never ship a build without a sanitized config).
  -->
  <PropertyGroup Condition="'$(CoWorkerUse)' == 'true'">
    <_CwPackTool>$(MSBuildThisFileDirectory)..\tools\Pack-CoWorkerConfig.ps1</_CwPackTool>
  </PropertyGroup>

  <Target Name="CoWorkerPackConfigAfterBuild" AfterTargets="Build" Condition="'$(CoWorkerUse)' == 'true'">
    <PropertyGroup>
      <_CwBuildDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))</_CwBuildDir>
      <_CwBuildDir>$(_CwBuildDir.TrimEnd('\'))</_CwBuildDir>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(_CwPackTool)&quot; -OutDir &quot;$(_CwBuildDir)&quot;" />
  </Target>

  <Target Name="CoWorkerPackConfigAfterPublish" AfterTargets="Publish" Condition="'$(CoWorkerUse)' == 'true'">
    <PropertyGroup>
      <_CwPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_CwPublishDir>
      <_CwPublishDir>$(_CwPublishDir.TrimEnd('\'))</_CwPublishDir>
    </PropertyGroup>
    <!-- -Ship: the publish folder goes to co-workers, so user credentials are always written EMPTY there. -->
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(_CwPackTool)&quot; -OutDir &quot;$(_CwPublishDir)&quot; -Ship" />
  </Target>

</Project>
