<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!--
    CO_WORKER_USE only: the AES master key is compiled in from build_secrets\CoWorkerKey.g.cs.
    That file is created by tools\Initialize-CoWorkerKey.ps1 (the 3_/4_/5_ coworker scripts call it) and is gitignored.
  -->
  <PropertyGroup Condition="'$(CoWorkerUse)' == 'true'">
    <CoWorkerKeySource>$(MSBuildThisFileDirectory)..\build_secrets\CoWorkerKey.g.cs</CoWorkerKeySource>
  </PropertyGroup>

  <ItemGroup Condition="'$(CoWorkerUse)' == 'true' And Exists('$(CoWorkerKeySource)')">
    <Compile Include="$(CoWorkerKeySource)" Link="Generated\CoWorkerKey.g.cs" />
  </ItemGroup>

  <Target Name="_RequireCoWorkerKey" BeforeTargets="CoreCompile"
          Condition="'$(CoWorkerUse)' == 'true' And !Exists('$(CoWorkerKeySource)')">
    <Error Text="Co-worker build needs the credential key file '$(CoWorkerKeySource)'. Run tools\Initialize-CoWorkerKey.ps1 first (or use 3_build_release_coworker.ps1 / 4_publish_coworker.ps1, which do it for you)." />
  </Target>

</Project>
